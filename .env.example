# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# New Supabase projects may label this as a publishable key.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_ADMIN_EMAILS=admin@example.com

# Seed scripts only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
VITE_APP_URL=https://www.nokta.uk

# Supabase Edge Functions / transactional email
APP_URL=https://www.nokta.uk
RESEND_API_KEY=
EMAIL_FROM_NAME=Nokta
EMAIL_FROM_ADDRESS=hello@nokta.uk

# Which environment venue analytics events are recorded against.
# Reporting counts "production" only. Leave unset locally: anything that is not a
# production build already falls back to "development". Set to "preview" on
# preview deployments so they are excluded too.
VITE_ANALYTICS_ENV=
