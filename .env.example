# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# New Supabase projects may label this as a publishable key.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_ADMIN_EMAILS=admin@example.com

# Seed scripts, and the /api/send-notification-email proxy on Vercel.
# SUPABASE_URL must be set in the Vercel server environment for that route to work.
SUPABASE_URL=https://your-project.supabase.co
# Seed scripts only. Never set this in Vercel: the proxy does not need it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
VITE_APP_URL=https://www.nokta.uk

# Supabase Edge Functions / transactional email
APP_URL=https://www.nokta.uk
RESEND_API_KEY=
EMAIL_FROM_NAME=Nokta
EMAIL_FROM_ADDRESS=hello@nokta.uk

# Shared secret authenticating the /api/send-notification-email proxy to the
# send-notification-email edge function. Generate with `openssl rand -hex 32`.
# The SAME value must be set in two places: Vercel (server env, never VITE_) and
# Supabase edge function secrets. Without it the function rejects every call.
NOTIFICATION_DISPATCH_SECRET=

# Which environment venue analytics events are recorded against.
# Reporting counts "production" only. Leave unset locally: anything that is not a
# production build already falls back to "development". Set to "preview" on
# preview deployments so they are excluded too.
VITE_ANALYTICS_ENV=
