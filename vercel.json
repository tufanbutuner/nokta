{
  "redirects": [
    {
      "source": "/discover",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/server-card",
      "destination": "/mcp-server-card.json"
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/.well-known/ard.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mcp-server-card.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
