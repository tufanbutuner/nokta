{
  "redirects": [
    {
      "source": "/discover",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/.well-known/ard.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
